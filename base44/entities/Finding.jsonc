{
  "name": "Finding",
  "type": "object",
  "properties": {
    "screening_id": {
      "type": "string",
      "description": "Reference to the parent Screening record"
    },
    "finding_type": {
      "type": "string",
      "description": "Type of tampering/inconsistency indicator"
    },
    "severity": {
      "type": "string",
      "description": "low | medium | high"
    },
    "confidence": {
      "type": "number",
      "description": "Indicator confidence 0-1"
    },
    "explanation": {
      "type": "string",
      "description": "Human-readable explanation of the indicator"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}