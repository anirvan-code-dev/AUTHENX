{
  "name": "ExtractedField",
  "type": "object",
  "properties": {
    "screening_id": {
      "type": "string",
      "description": "Reference to the parent Screening record"
    },
    "field_name": {
      "type": "string",
      "description": "Name of the extracted document field"
    },
    "value": {
      "type": "string",
      "description": "Extracted value of the field"
    },
    "confidence": {
      "type": "number",
      "description": "OCR confidence 0-1"
    },
    "validation_status": {
      "type": "string",
      "description": "valid | review | inconsistency"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}